generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id
  username        String   @unique
  name            String
  email           String   @unique
  passwordHash    String
  balance         Float
  startingBalance Float
  bio             String   @default("")
  avatarColor     String
  isDemo          Boolean   @default(false)
  isBot           Boolean   @default(false)
  lastBonusAt     DateTime?
  createdAt       DateTime  @default(now())

  positions     Position[]
  trades        Trade[]
  comments      Comment[]
  markets       Market[]       @relation("CreatedMarkets")
  notifications Notification[]
  bookmarks     Bookmark[]
  pnlEntries    PnlEntry[]
  limitOrders   LimitOrder[]
  pollVotes     PollVote[]
  worthPoints   WorthPoint[]
  commentLikes  CommentLike[]
  following     Follow[]       @relation("Following")
  followers     Follow[]       @relation("Followers")
  tipsSent      Tip[]          @relation("TipsSent")
  tipsReceived  Tip[]          @relation("TipsReceived")
}

model Market {
  id             String    @id
  slug           String    @unique
  question       String
  description    String
  type           String
  topic          String
  closeAt        DateTime
  createdAt      DateTime
  resolvedAt     DateTime?
  resolution     String?
  resolutionProb Float?
  resolutionNote String    @default("")
  poolYes        Float     @default(0)
  poolNo         Float     @default(0)
  p              Float     @default(0.5)
  probability    Float     @default(0.5)
  pot            Float     @default(0)
  ante           Float     @default(0)
  volume         Float     @default(0)
  traderCount    Int       @default(0)
  liquidity      Float     @default(0)
  creatorBlocked Boolean   @default(false)
  creatorId      String
  creator        User      @relation("CreatedMarkets", fields: [creatorId], references: [id])

  answers    Answer[]
  trades     Trade[]
  comments   Comment[]
  positions  Position[]
  points     ProbPoint[]
  bookmarks   Bookmark[]
  pnlEntries  PnlEntry[]
  limitOrders LimitOrder[]
  pollVotes   PollVote[]
  updates     MarketUpdate[]

  @@index([topic, createdAt])
  @@index([resolvedAt])
}

model Answer {
  id          String @id
  marketId    String
  market      Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  text        String
  sortIndex   Int
  pool        Float
  probability Float

  @@index([marketId, sortIndex])
}

model Position {
  id          String @id
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId    String
  market      Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  answerId    String @default("")
  sharesYes   Float  @default(0)
  sharesNo    Float  @default(0)
  shares      Float  @default(0)
  invested     Float @default(0)
  costBasisYes Float @default(0)
  costBasisNo  Float @default(0)
  realizedPnl  Float @default(0)
  payout       Float @default(0)

  @@unique([userId, marketId, answerId])
  @@index([marketId])
  @@index([userId])
}

model PollVote {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  answerId  String
  createdAt DateTime @default(now())

  @@unique([userId, marketId])
  @@index([marketId])
}

model WorthPoint {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  worth     Float
  createdAt DateTime

  @@index([userId, createdAt])
}

model LimitOrder {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcome   String
  limitProb Float
  amount    Float
  remaining Float
  status    String
  createdAt DateTime @default(now())

  @@index([marketId, status])
  @@index([userId, status])
}

model Trade {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  answerId   String   @default("")
  outcome    String
  side       String
  amount     Float
  shares     Float
  probBefore Float
  probAfter  Float
  createdAt  DateTime

  @@index([marketId, createdAt])
  @@index([userId, createdAt])
}

model Comment {
  id        String    @id
  marketId  String
  market    Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  body      String
  createdAt DateTime
  editedAt  DateTime?
  deleted   Boolean   @default(false)
  likes     CommentLike[]

  @@index([marketId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model Tip {
  id        String   @id
  fromId    String
  toId      String
  from      User     @relation("TipsSent", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("TipsReceived", fields: [toId], references: [id], onDelete: Cascade)
  amount    Float
  note      String   @default("")
  createdAt DateTime

  @@index([toId, createdAt])
}

model MarketUpdate {
  id        String   @id
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  kind      String
  body      String
  createdAt DateTime

  @@index([marketId, createdAt])
}

model CommentLike {
  userId    String
  commentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, commentId])
  @@index([commentId])
}

model ProbPoint {
  id          String   @id
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  probability Float
  snapshot    String
  createdAt   DateTime

  @@index([marketId, createdAt])
}

model Notification {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String
  read      Boolean  @default(false)
  createdAt DateTime

  @@index([userId, createdAt])
}

model Bookmark {
  userId    String
  marketId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, marketId])
}

model PnlEntry {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  amount    Float
  createdAt DateTime

  @@index([userId, createdAt])
}
